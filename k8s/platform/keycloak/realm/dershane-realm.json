{
  "realm": "dershane",
  "displayName": "Dershane",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "accessTokenLifespan": 300,
  "loginTheme": "dershane",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "tr"
  ],
  "defaultLocale": "tr",
  "smtpServer": {
    "host": "{{ .smtpHost }}",
    "port": "{{ .smtpPort }}",
    "from": "no-reply@onlinecourses.site",
    "fromDisplayName": "Dershane",
    "auth": "true",
    "user": "{{ .smtpUsername }}",
    "password": "{{ .smtpPassword }}",
    "starttls": "true",
    "ssl": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "student",
        "description": "Öğrenci"
      },
      {
        "name": "teacher",
        "description": "Öğretmen"
      },
      {
        "name": "guardian",
        "description": "Veli"
      },
      {
        "name": "admin",
        "description": "Şube yöneticisi"
      },
      {
        "name": "super-admin",
        "description": "Tüm şubeleri yöneten yönetici (admin ile birlikte verilir)"
      }
    ]
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"admin\",\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"admin\",\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"branch_id\",\"displayName\":\"Branch\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "dershane-frontend",
      "name": "Dershane web app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://onlinecourses.site/*"
      ],
      "webOrigins": [
        "https://onlinecourses.site"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://onlinecourses.site/*"
      },
      "protocolMappers": [
        {
          "name": "audience-dershane-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "dershane-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "branch-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "branch_id",
            "claim.name": "branch_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false"
          }
        }
      ]
    },
    {
      "clientId": "user-service",
      "name": "user service (Admin API access)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "{{ .userServiceClientSecret }}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-user-service",
      "enabled": true,
      "serviceAccountClientId": "user-service",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm"
        ]
      }
    },
    {
      "id": "00000000-0000-0000-0000-00000000a001",
      "username": "superadmin@onlinecourses.site",
      "email": "superadmin@onlinecourses.site",
      "emailVerified": true,
      "firstName": "Sistem",
      "lastName": "Yöneticisi",
      "enabled": true,
      "attributes": {
        "branch_id": [
          "00000000-0000-0000-0000-00000000b001"
        ]
      },
      "realmRoles": [
        "admin",
        "super-admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "{{ .superadminPassword }}",
          "temporary": true
        }
      ]
    }
  ]
}
