{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dershane.local/events/StudentResultAdded.v1.json",
  "title": "StudentResultAdded",
  "description": "Producer: exam-analysis. A result was added to an already published exam by matching an unmatched optical row; notify only this student (and their parents). ExamResultsPublished is not sent again.",
  "allOf": [{"$ref": "_envelope.v1.json"}],
  "properties": {
    "eventType": {"const": "StudentResultAdded"},
    "version": {"const": 1},
    "producer": {"const": "exam-analysis"},
    "payload": {
      "type": "object",
      "required": ["mockExamId", "branchId", "studentId"],
      "properties": {
        "mockExamId": {"type": "string", "format": "uuid"},
        "branchId": {"type": "string", "format": "uuid"},
        "studentId": {"type": "string", "format": "uuid"}
      },
      "additionalProperties": false
    }
  }
}
