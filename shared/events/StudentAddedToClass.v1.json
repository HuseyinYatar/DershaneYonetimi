{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dershane.local/events/StudentAddedToClass.v1.json",
  "title": "StudentAddedToClass",
  "description": "Producer: user service. A student was added to a class. Consumers (exam-analysis, task, attendance) keep a local copy; exam-analysis matches optical rows through branchId + studentNo. Contains personal data: never log the payload.",
  "allOf": [{"$ref": "_envelope.v1.json"}],
  "properties": {
    "eventType": {"const": "StudentAddedToClass"},
    "version": {"const": 1},
    "payload": {
      "type": "object",
      "required": ["studentId", "studentNo", "branchId", "classId", "fullName"],
      "properties": {
        "studentId": {"type": "string", "format": "uuid", "description": "Keycloak sub"},
        "studentNo": {"type": "string", "minLength": 1, "maxLength": 32},
        "branchId": {"type": "string", "format": "uuid"},
        "classId": {"type": "string", "format": "uuid"},
        "fullName": {"type": "string", "minLength": 1, "maxLength": 200}
      },
      "additionalProperties": false
    }
  }
}
