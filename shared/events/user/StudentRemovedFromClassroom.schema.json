{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dershane.local/events/user/StudentRemovedFromClassroom.schema.json",
  "title": "StudentRemovedFromClassroom (schemaVersion 1)",
  "description": "A student left a classroom (moved to another one, removed, or deactivated). When moving, it is published before the StudentAddedToClassroom of the new classroom. Consumers: task, attendance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["membershipId", "studentId", "classroomId", "branchId", "endDate"],
  "properties": {
    "membershipId": { "$ref": "#/$defs/uuid" },
    "studentId": { "$ref": "#/$defs/uuid" },
    "classroomId": { "$ref": "#/$defs/uuid" },
    "branchId": { "$ref": "#/$defs/uuid" },
    "endDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
