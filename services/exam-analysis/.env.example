# Local development against local/docker-compose.yml. Copy to .env (never commit .env).
DATABASE_URL=postgresql+psycopg://exam_analysis:exam_analysis@localhost:5432/exam_analysis
REDIS_URL=redis://localhost:6379/0
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=eu-central-1
OIDC_ISSUER=http://localhost:8080/realms/dershane
OIDC_JWKS_URL=http://localhost:8080/realms/dershane/protocol/openid-connect/certs
OIDC_AUDIENCE=exam-analysis
OUTBOX_RELAY_ENABLED=false
# SNS_TOPIC_ARN is printed by `python -m app.cli bootstrap-local`
SNS_TOPIC_ARN=
