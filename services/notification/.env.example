# Local development against local/docker-compose.yml. Copy to .env (never commit .env).
# If PostgreSQL runs on another host port (POSTGRES_PORT in local/.env), change it here too.
DATABASE_URL=postgresql+psycopg://notification:notification@localhost:5432/notification
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=eu-central-1
# Created by floci-init (local/floci/init.sh), subscribed to user-events and exam-analysis-events.
SQS_QUEUE_NAME=notification-queue
# Mailpit: every mail is caught, nothing leaves the machine. UI: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
FRONTEND_BASE_URL=http://localhost:3000
OIDC_ISSUER=http://localhost:8180/realms/dershane
OIDC_JWKS_URL=http://localhost:8180/realms/dershane/protocol/openid-connect/certs
OIDC_AUDIENCE=dershane-api
