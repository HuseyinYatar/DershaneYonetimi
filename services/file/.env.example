# Local development against local/docker-compose.yml. Copy to .env (never commit .env).
# If PostgreSQL runs on another host port (POSTGRES_PORT in local/.env), change it here too.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://file_service:file_service@localhost:5432/file_service
AWS_ENDPOINT_URL=http://localhost:4566
# Download URLs are signed for this address; in a container AWS_ENDPOINT_URL is http://floci:4566
# but the browser still reaches Floci on localhost.
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=eu-central-1
# Created by floci-init (infra/terraform).
FILES_BUCKET=file-uploads
OIDC_ISSUER=http://localhost:8180/realms/dershane
OIDC_JWKS_URL=http://localhost:8180/realms/dershane/protocol/openid-connect/certs
OIDC_AUDIENCE=dershane-api
