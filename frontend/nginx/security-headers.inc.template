# Included by every location: add_header in a child block replaces the inherited ones.
# CSP_CONNECT_SRC / CSP_FRAME_SRC (gateway and Keycloak origins) are substituted at container start.
# style-src needs 'unsafe-inline' because sonner injects a <style> tag.
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header X-Frame-Options "SAMEORIGIN" always;
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${CSP_CONNECT_SRC}; frame-src ${CSP_FRAME_SRC}; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self' ${CSP_FRAME_SRC}" always;
