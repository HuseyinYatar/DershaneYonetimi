#!/bin/bash
# Prepares an Ubuntu 24.04 node for kubeadm. cloud-init runs it once on first boot; it is safe to run
# again by hand (sudo bash). It does not create or join the cluster: kubeadm init/join, the CNI and
# Traefik come afterwards. Progress: /var/log/node-prep.log. Done when /var/lib/node-prep.done exists.
#
# Rendered by Terraform (templatefile): only the values below are filled in; shell variables are
# written as $NAME without braces so Terraform leaves them alone.
set -euo pipefail
exec > >(tee -a /var/log/node-prep.log) 2>&1

NODE_NAME="${hostname}"
NODE_ROLE="${role}"
NODE_IP="${private_ip}"
KUBERNETES_VERSION="${kubernetes_version}"
ECR_CREDENTIAL_PROVIDER_VERSION="${ecr_credential_provider_version}"

export DEBIAN_FRONTEND=noninteractive
echo "node-prep: start ($NODE_NAME, $NODE_ROLE, kubernetes $KUBERNETES_VERSION)"

# 1. Host name. kubectl get nodes shows cp, w1, w2 instead of ip-10-0-1-11. The name resolves to the
#    private IP so the kubelet and kubeadm pick the VPC address.
hostnamectl set-hostname "$NODE_NAME"
echo "preserve_hostname: true" > /etc/cloud/cloud.cfg.d/99-preserve-hostname.cfg
sed -i "/[[:space:]]$NODE_NAME\$/d" /etc/hosts
echo "$NODE_IP $NODE_NAME" >> /etc/hosts

# 2. Swap off. The kubelet refuses to start while swap is on (failSwapOn: true).
swapoff -a
sed -ri '/[[:space:]]swap[[:space:]]/ s/^([^#])/#\1/' /etc/fstab

# 3. Kernel modules and sysctl: overlay for container layers, br_netfilter and ip_forward so pod
#    traffic crossing the node bridge goes through iptables and can be routed.
cat > /etc/modules-load.d/k8s.conf <<EOF
overlay
br_netfilter
EOF
modprobe overlay
modprobe br_netfilter

cat > /etc/sysctl.d/99-kubernetes.conf <<EOF
net.bridge.bridge-nf-call-iptables  = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward                 = 1
EOF
sysctl --system >/dev/null

# 4. Package repositories: Docker's for containerd 2.x (Kubernetes 1.36+ needs containerd 2),
#    pkgs.k8s.io for one Kubernetes minor version.
apt-get update -q
apt-get install -y -q apt-transport-https ca-certificates curl gpg unzip

install -m 0755 -d /etc/apt/keyrings
CODENAME="$(. /etc/os-release && echo "$VERSION_CODENAME")"
ARCH="$(dpkg --print-architecture)"

curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
echo "deb [arch=$ARCH signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $CODENAME stable" \
  > /etc/apt/sources.list.d/docker.list

curl -fsSL "https://pkgs.k8s.io/core:/stable:/v$KUBERNETES_VERSION/deb/Release.key" \
  | gpg --dearmor --yes -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v$KUBERNETES_VERSION/deb/ /" \
  > /etc/apt/sources.list.d/kubernetes.list

apt-get update -q

# 5. containerd. The package ships a config with the CRI plugin disabled, so a full default config is
#    written. SystemdCgroup = true: the kubelet uses the systemd cgroup driver, both must agree.
if ! dpkg -s containerd.io >/dev/null 2>&1; then
  apt-get install -y -q containerd.io
fi
apt-mark hold containerd.io >/dev/null

mkdir -p /etc/containerd
containerd config default > /etc/containerd/config.toml
sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
if ! grep -q 'SystemdCgroup = true' /etc/containerd/config.toml; then
  echo "node-prep: SystemdCgroup could not be set in /etc/containerd/config.toml" >&2
  exit 1
fi
systemctl enable containerd >/dev/null
systemctl restart containerd

# 6. kubelet, kubeadm, kubectl. Held so apt upgrade cannot move them past the cluster version;
#    upgrades go through kubeadm upgrade. Installed only once: a rerun must not touch a live node.
if ! dpkg -s kubeadm >/dev/null 2>&1; then
  apt-get install -y -q kubelet kubeadm kubectl
fi
apt-mark hold kubelet kubeadm kubectl >/dev/null
systemctl enable kubelet >/dev/null

# 7. ECR pulls. On kubeadm the kubelet does not use the instance profile by itself; this credential
#    provider exchanges the node role for an ECR token whenever an image matches the pattern.
PROVIDER_DIR=/opt/kubelet/credential-providers
PROVIDER_URL="https://artifacts.k8s.io/binaries/cloud-provider-aws/v$ECR_CREDENTIAL_PROVIDER_VERSION/linux/$ARCH/ecr-credential-provider-linux-$ARCH"
mkdir -p "$PROVIDER_DIR" /etc/kubelet-credential-provider
curl -fsSL "$PROVIDER_URL" -o /tmp/ecr-credential-provider
echo "$(curl -fsSL "$PROVIDER_URL.sha256")  /tmp/ecr-credential-provider" | sha256sum -c -
install -m 0755 /tmp/ecr-credential-provider "$PROVIDER_DIR/ecr-credential-provider"

cat > /etc/kubelet-credential-provider/config.yaml <<EOF
apiVersion: kubelet.config.k8s.io/v1
kind: CredentialProviderConfig
providers:
  - name: ecr-credential-provider
    apiVersion: credentialprovider.kubelet.k8s.io/v1
    matchImages:
      - "*.dkr.ecr.*.amazonaws.com"
    defaultCacheDuration: "12h"
EOF

# kubeadm's systemd drop-in reads KUBELET_EXTRA_ARGS from this file. --node-ip pins the VPC address.
cat > /etc/default/kubelet <<EOF
KUBELET_EXTRA_ARGS=--node-ip=$NODE_IP --image-credential-provider-config=/etc/kubelet-credential-provider/config.yaml --image-credential-provider-bin-dir=$PROVIDER_DIR
EOF

# 8. AWS CLI on the control plane: etcd snapshots and the IRSA keys.json go to S3 with the node role.
if [ "$NODE_ROLE" = "control-plane" ] && ! command -v aws >/dev/null 2>&1; then
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" -o /tmp/awscliv2.zip
  unzip -q -o /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install --update
  rm -rf /tmp/aws /tmp/awscliv2.zip
fi

touch /var/lib/node-prep.done
echo "node-prep: done ($NODE_NAME)"
