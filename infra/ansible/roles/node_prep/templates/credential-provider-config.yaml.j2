# {{ ansible_managed }}
# The kubelet calls ecr-credential-provider for images matching the pattern; the provider uses the node's
# instance role to get an ECR token, cached for 12 hours.
apiVersion: kubelet.config.k8s.io/v1
kind: CredentialProviderConfig
providers:
  - name: ecr-credential-provider
    apiVersion: credentialprovider.kubelet.k8s.io/v1
    matchImages:
      - "{{ node_prep_ecr_image_pattern }}"
    defaultCacheDuration: "12h"
