   "text": "sheet_key │ question_no │ given_answer │ answer_key_item_id │ subject_id │ topic_id       │ correct_answer │ is_cancelled │ status \n──────────┼─────────────┼──────────────┼────────────────────┼────────────┼────────────────┼────────────────┼──────────────┼────────\n1         │ 1           │ C            │ k-a1               │ turkce     │ paragraf       │ C              │ False        │ CORRECT\n1         │ 2           │ D            │ k-a2               │ turkce     │ paragraf       │ D              │ False        │ CORRECT\n1         │ 3           │ B            │ k-a3               │ turkce     │ sozcukte-anlam │ A              │ False        │ WRONG  \n1         │ 4           │ A            │ k-a4               │ mat        │ problemler     │ A              │ False        │ CORRECT\n1         │ 5           │ D            │ k-a5               │ mat        │ problemler     │ D              │ False        │ CORRECT\n1         │ 6           │ B            │ k-a6               │ mat        │ uslu-sayilar   │ B              │ False        │ CORRECT\n2         │ 1           │ C            │ k-a1               │ turkce     │ paragraf       │ C              │ False        │ CORRECT\n2         │ 2           │ B            │ k-a2               │ turkce     │ paragraf       │ D              │ False        │ WRONG  \n2         │ 3           │ None         │ k-a3               │ turkce     │ sozcukte-anlam │ A              │ False        │ BLANK  \n2         │ 4           │ A            │ k-a4               │ mat        │ problemler     │ A              │ False        │ CORRECT\n2         │ 5           │ D            │ k-a5               │ mat        │ problemler     │ D              │ False        │ CORRECT\n2         │ 6           │ *            │ k-a6               │ mat        │ uslu-sayilar   │ B              │ False        │ WRONG  ",
   "originalText": "sheet_key │ question_no │ given_answer │ answer_key_item_id │ subject_id │ topic_id       │ correct_answer │ is_cancelled │ status \n──────────┼─────────────┼──────────────┼────────────────────┼────────────┼────────────────┼────────────────┼──────────────┼────────\n1         │ 1           │ C            │ k-a1               │ turkce     │ paragraf       │ C              │ False        │ CORRECT\n1         │ 2           │ D            │ k-a2               │ turkce     │ paragraf       │ D              │ False        │ CORRECT\n1         │ 3           │ B            │ k-a3               │ turkce     │ sozcukte-anlam │ A              │ False        │ WRONG  \n1         │ 4           │ A            │ k-a4               │ mat        │ problemler     │ A              │ False        │ CORRECT\n1         │ 5           │ D            │ k-a5               │ mat        │ problemler     │ D              │ False        │ CORRECT\n1         │ 6           │ B            │ k-a6               │ mat        │ uslu-sayilar   │ B              │ False        │ CORRECT\n2         │ 1           │ C            │ k-a1               │ turkce     │ paragraf       │ C              │ False        │ CORRECT\n2         │ 2           │ B            │ k-a2               │ turkce     │ paragraf       │ D              │ False        │ WRONG  \n2         │ 3           │ None         │ k-a3               │ turkce     │ sozcukte-anlam │ A              │ False        │ BLANK  \n2         │ 4           │ A            │ k-a4               │ mat        │ problemler     │ A              │ False        │ CORRECT\n2         │ 5           │ D            │ k-a5               │ mat        │ problemler     │ D              │ False        │ CORRECT\n2         │ 6           │ *            │ k-a6               │ mat        │ uslu-sayilar   │ B              │ False        │ WRONG  ",
